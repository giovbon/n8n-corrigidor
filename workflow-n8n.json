    {
      "parameters": {
        "jsCode": "let rawText = $input.item.json.content.parts[0].text;\n\n// Remove marcadores de markdown ```json e ```\nrawText = rawText.replace(/```json|```/g, '').trim();\n\nlet nota = null;\nlet feedback = \"\";\n\ntry {\n  // Tenta fazer o parse normal\n  const parsed = JSON.parse(rawText);\n  nota = parsed.nota;\n  feedback = parsed.feedback;\n} catch (e) {\n  // Caso o JSON falhe devido a quebras de linha no analise_detalhada,\n  // usa Expressão Regular para extrair diretamente a nota e o feedback:\n  const notaMatch = rawText.match(/\"nota\"\\s*:\\s*([\\d.]+)/);\n  const feedbackMatch = rawText.match(/\"feedback\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*\\}/);\n\n  if (notaMatch) nota = parseFloat(notaMatch[1]);\n  if (feedbackMatch) feedback = feedbackMatch[1].replace(/\\\\n/g, '\\n');\n}\n\nreturn {\n  json: {\n    nota: nota,\n    feedback: feedback\n  }\n};"
      },
