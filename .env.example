# ---------------------------------------------------------------------------
# Copie para .env e ajuste. O .env NÃO vai para o git.
#
# Gere a chave de criptografia com:  openssl rand -hex 32
#
# CUIDADO, nesta ordem:
#   * Se o volume do n8n JÁ EXISTE e as credenciais funcionam, a chave atual está
#     em n8n_data/config.json (campo "encryptionKey") — copie ESSA chave para cá.
#     Definir uma chave nova com dados antigos torna as credenciais salvas
#     irrecuperáveis.
#   * Se o volume é novo, gere uma chave agora e guarde-a em local seguro.
# ---------------------------------------------------------------------------
# N8N_ENCRYPTION_KEY=

# Versão do n8n. Descubra a que está rodando com:
#   docker compose exec n8n n8n --version
# e fixe aqui para que uma atualização não mude o comportamento no meio do semestre.
N8N_TAG=latest

# Fuso usado nos timestamps que o n8n grava na planilha.
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# Deixe em false para acessar por http://localhost:5678 sem quebrar o login.
N8N_SECURE_COOKIE=false

# Opcional: se preenchido, o POST /check passa a exigir o header X-API-Key.
# O workflow precisa enviar o mesmo valor.
# API_TOKEN=

# Limites da análise (opcionais; os valores abaixo são os padrões).
MAX_UPLOAD_MB=25
MAX_DESCOMPACTADO_MB=300
MAX_MEMBROS_ZIP=1000
MAX_ARQUIVOS_ANALISADOS=400
MAX_CHARS_CODIGO_COMPLETO=60000
RUFF_TIMEOUT_SEGUNDOS=60
